# Copiez ce fichier en .env (cp .env.example .env). Ne commitez JAMAIS le .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=changez-moi-en-local
DEBUG=True

# Avec Docker (docker compose up) : laissez ces valeurs.
DATABASE_URL=postgres://cargohub:cargohub@db:5432/cargohub
REDIS_URL=redis://redis:6379/0
# Sans Docker : commentez les 2 lignes ci-dessus → SQLite + tâches exécutées directement.

# IA (facultatif) — clé gratuite sur https://console.groq.com
AI_API_KEY=
# Vérification des marchandises (M2) — clé Gemini, jamais dans le code
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
CARTO_API_KEY=

# Stripe mode test (M5) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Emails : affichés dans la console en local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
