# Copiez ce fichier en .env (cp .env.example .env). Ne commitez JAMAIS le .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=changez-moi-en-local
DEBUG=True

# Avec Docker (docker compose up) : laissez ces valeurs.
DATABASE_URL=postgres://cargohub:cargohub@db:5432/cargohub
REDIS_URL=redis://redis:6379/0
# Sans Docker : commentez les 2 lignes ci-dessus → SQLite + tâches exécutées directement.

# IA (facultatif) — clé gratuite sur https://console.groq.com
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Explication IA des scores (ne jamais commiter la valeur réelle).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Audio (facultatif) — OpenAI Audio API : transcription et synthèse vocale
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Stripe mode test (M5) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Emails : affichés dans la console en local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
